# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creatoros?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/creatoros?schema=public"

# Node Environment & Server
PORT=5000
NODE_ENV=development
JWT_SECRET="creatoros-super-secret-jwt-key-2026"
SESSION_SECRET="creatoros-session-secret-production"

# Demo Mode (Simulates omnichannel metrics & background processing out of the box)
DEMO_MODE=true

# AI Provider Credentials
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""

# Cloudinary / Media Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

