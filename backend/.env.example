# PostgreSQL Database Configuration
# Local throwaway cluster on port 5433 (data dir: C:\Users\ak949\pgdata-creatoros,
# password `postgres`). The machine-wide Postgres on 5432 is password-locked,
# so this project uses its own user-owned instance instead.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/creatoros?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/creatoros?schema=public"

# Node Environment & Server
PORT=5000
NODE_ENV=development
# ALLOWED ORIGINS (comma separated) for credentialed CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — must be changed from these defaults.
JWT_SECRET="change-me-jwt-secret-32-characters-minimum"
REFRESH_TOKEN_SECRET="change-me-refresh-secret-32-characters-min"
# Access token lifetime (ms/seconds style: 15m, 1h, ...)
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
# Leave empty to auto-detect (secure in production, lax in development)
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=

# ── OTP / Email verification ────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=5
PASSWORD_RESET_TTL_MINUTES=30

# ── Email provider ──────────────────────────────────────────────────────────
# 'resend' | 'brevo' | 'log'   ('log' prints mails to the server console)
EMAIL_PROVIDER=log
EMAIL_FROM="CreatorOS <onboarding@resend.dev>"
EMAIL_FROM_NAME="CreatorOS"
RESEND_API_KEY=""
BREVO_API_KEY=""
# Public URL of the frontend — used to build password-reset links
APP_URL="http://localhost:5173"

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
SENSITIVE_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=60

# ── Admin console ───────────────────────────────────────────────────────────
# Bootstrapped by `npm run seed:admin` (password is set there if empty).
ADMIN_EMAIL="admin@creatoros.ai"
ADMIN_NAME="CreatorOS Super Admin"
ADMIN_PASSWORD=""

# ── AI Provider Credentials ─────────────────────────────────────────────────
# AI_PROVIDER: openai | huggingface | mock | auto   ('auto' = first key found)
# With no key at all the app falls back to a deterministic offline mock so every
# screen still renders — you just get canned copy instead of real generation.
AI_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Hugging Face Inference Providers (OpenAI-compatible).
# 1. Create a token: https://huggingface.co/settings/tokens  (read is enough)
# 2. Set AI_MODEL to a chat model, e.g. Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_API_KEY=""
HUGGINGFACE_BASE_URL="https://router.huggingface.co/v1"

# Anthropic (needs an OpenAI-compatible gateway — see README)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Point ANY provider at a local server (Ollama, vLLM, LM Studio) instead
# AI_BASE_URL="http://localhost:11434/v1"

AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=60000
AI_MONTHLY_TOKEN_BUDGET=500000
# Set to false for models that reject `response_format: json_object`
AI_JSON_MODE=true

# ── Cloudinary / Media Storage ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=100

# ── Social Platform OAuth Keys ──────────────────────────────────────────────
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

