# ==========================================================
# CreatorOS | Root .gitignore
# Monorepo: frontend (React+Vite) · admin (React+Vite) · backend (Express+TS+Prisma)
# ==========================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnp.cjs
jspm_packages/

# Build output
build/
out/
dist/
dist-ssr/
**/dist/
**/dist-ssr/
**/build/
**/out/
*.tsbuildinfo

# Tooling caches
.vite/
**/.vite/
.cache/
**/.cache/
cache/
.temp/
.tmp/
**/.temp/
**/.tmp/
.eslintcache
.oxlintcache
.stylelintcache

# Environment variables & secrets
.env
**/.env
.env.local
**/.env.local
.env.development
**/.env.development
.env.development.local
**/.env.development.local
.env.test
**/.env.test
.env.production
**/.env.production
.env.production.local
**/.env.production.local
.env.staging
**/.env.staging
.env.*.local
**/.env.*.local

# Logs
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & coverage
coverage/
**/coverage/
*.lcov
.nyc_output/
**/.nyc_output/

# Databases / local runtime artifacts
*.db
*.db-journal
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3

# Prisma migrations
/backend/prisma/migrations/

# Runtime data and uploads
uploads/
storage/
**/uploads/
**/storage/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
**/*.local

# OS files
.DS_Store
**/.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Miscellaneous
*.pid
*.pid.lock
*.seed
*.orig
*.rej
